local function mkToggle(txtOn, txtOff, y, getVal, setVal)
    local btn = Instance.new("TextButton", content)
    btn.Size, btn.Position, btn.BackgroundColor3, btn.BorderSizePixel, btn.ZIndex =
        UDim2.new(1, 0, 0, 30), UDim2.new(0, 0, 0, y), COLOR_PANEL, 0, 3
    mkCorner(btn, 6)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color, stroke.Thickness, stroke.Transparency = COLOR_NEON_DIM, 1, 0.5
    local function refresh()
        local on = getVal()
        btn.Text = on and txtOn or txtOff
        btn.TextColor3 = on and COLOR_NEON or Color3.fromRGB(150, 150, 152)
        stroke.Color = on and COLOR_NEON or Color3.fromRGB(95, 80, 80)
        btn.BackgroundColor3 = on and Color3.fromRGB(45, 12, 14) or COLOR_PANEL
    end
    btn.TextColor3, btn.Font, btn.TextSize = COLOR_TEXT, Enum.Font.Code, 9
    btn.MouseButton1Click:Connect(function()
        setVal(not getVal())
        refresh()
    end)
    refresh()
    return btn
end

