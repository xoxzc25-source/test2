-- Кровавый взрыв: КРУПНЫЕ брызги насыщенно-красной крови вокруг точки.
-- Летят по дуге и медленно тают — их реально видно.
local function spawnBloodBurst(originCF, count)
    for i = 1, count do
        local blood = Instance.new("Part")
        blood.Name = "QuantumBio_Blood"
        blood.Color = BLOOD_COLOR
        blood.Material = Enum.Material.SmoothPlastic
        blood.Shape = Enum.PartType.Ball
        blood.Size = Vector3.new(0.18, 0.18, 0.18) * (0.8 + math.random() * 1.4)
        blood.CanCollide, blood.CanTouch, blood.CanQuery, blood.Massless, blood.Anchored = false, false, false, true, true
        blood.CFrame = originCF * CFrame.new(
            (math.random() - 0.5) * 0.5,
            (math.random() - 0.5) * 0.5,
            (math.random() - 0.5) * 0.5
        )
        blood.Parent = workspace

        local angle = math.random() * math.pi * 2
        local dist = 1.5 + math.random() * 3
        local drop = 0.5 + math.random() * 2
        local startPos = originCF.Position
        local target = CFrame.new(startPos + Vector3.new(math.cos(angle) * dist, -drop, math.sin(angle) * dist))
            * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
        -- полёт по дуге
        TweenService:Create(
            blood,
            TweenInfo.new(0.7 * config.RegenSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {CFrame = target}
        ):Play()
        -- медленное растворение (не сжимается — капля остаётся заметной)
        TweenService:Create(
            blood,
            TweenInfo.new(1.6 * config.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
            {Transparency = 1}
        ):Play()
        task.delay(1.8 * config.RegenSpeed + 0.2, function()
            if blood then blood:Destroy() end
        end)
    end
end

-- =====================================================================
-- ПОСЛЕДОВАТЕЛЬНОСТЬ ПЕЧАТИ (универсальная: конечность или торс).
-- Лимита «одна за раз» нет: группы печатаются ПАРАЛЛЕЛЬНО.
-- Для торса кость-цилиндр читается как ПОЗВОНОЧНИК.
-- =====================================================================
local function runPrintSequence(limbName, parts)
    setPrinterStatus("ПЕЧАТЬ: " .. limbName .. "...")

    task.spawn(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then
            getgenv().busyLimbsRef[limbName] = false
            setPrinterStatus("ОШИБКА: НЕТ ТЕЛА")
            return
        end

        local anchorPart = parts[1]
        local originalSize = anchorPart.Size
        -- Точка роста: верх конечности (плечо/бедро). Всё печатается ОТ СЮДА ВНИЗ.
        local topOffset = CFrame.new(0, originalSize.Y / 2, 0)
        local speed = config.RegenSpeed

        -- ЗВУК ГЕНЕРАЦИИ: замедляем трек ровно под длительность печати
        -- (трек 1 сек → PlaybackSpeed 1/totalTime; на случай лагов — цикл)
        local totalTime = (VANISH_TIME + BONE_FADE + NERVE_FADE + FLESH_FADE + SKIN_FADE + 0.1) * speed
        -- звук генерации: общий на ВСЕ параллельные печати (один слой)
        startPrintSound(anchorPart, totalTime)

        -- Свежий снимок кожи: берём ТЕКУЩИЙ цвет/материал прямо перед печатью
        for _, p in ipairs(parts) do
            getgenv().originalDataRef[p] = {Color = p.Color, Material = p.Material, Transparency = p.Transparency}
        end

        -- ФАЗА 0: конечность уходит в портал (вспышка + исчезновение)
        for _, p in ipairs(parts) do
            p.Transparency = 1
            spawnPortalFlash(p, COLOR_FLASH_IN)
        end
        task.wait(VANISH_TIME * speed)

        -- ФАЗА 1: КОСТЬ v2 — главный shaft (трубчатая кость)
        local boneLen = originalSize.Y * 0.98
        -- торсу — более мощный ПОЗВОНОЧНИК
        local boneDiameter = math.min(originalSize.X, originalSize.Z) * ((limbName == "Torso") and 0.38 or 0.3)
        local bone = bioPart(
            "Bone",
            Vector3.new(boneLen, boneDiameter, boneDiameter), -- цилиндр: (длина, Ø, Ø)
            BONE_COLOR,
            Enum.Material.Slate,
            BONE_FADE,
            anchorPart,
            topOffset,
            0,
            true,
            limbName
        )

        if bone then
            if limbName == "Torso" then
                -- ТОРС: ГРУДНАЯ КЛЕТКА — 4 пары рёбер из позвоночника
                local ribLen = originalSize.X * 0.32
                local ribFracs = {0.32, 0.12, -0.08, -0.28}
                for _, f in ipairs(ribFracs) do
                    bioNode("Rib_R", Vector3.new(ribLen, 0.05, 0.04), BONE_COLOR, Enum.Material.Slate, BONE_FADE, bone, f, 0, false, "X", limbName, CFrame.Angles(0, 0, math.rad(-130)) * CFrame.new(ribLen / 2, 0, 0))
                    bioNode("Rib_L", Vector3.new(ribLen, 0.05, 0.04), BONE_COLOR, Enum.Material.Slate, BONE_FADE, bone, f, 0, false, "X", limbName, CFrame.Angles(0, 0, math.rad(130)) * CFrame.new(ribLen / 2, 0, 0))
                end
                -- ГРУДИНА: вертикальная пластина спереди грудной клетки
                bioPart(
                    "Sternum",
                    Vector3.new(0.1, originalSize.Y * 0.45, originalSize.Z * 0.13),
                    BONE_COLOR,
                    Enum.Material.Slate,
                    BONE_FADE,
                    anchorPart,
                    topOffset * CFrame.new(0, 0, originalSize.Z / 2 - 0.06),
                    0,
                    false,
                    limbName
                )
            else
                -- КОНЕЧНОСТЬ v2:
                -- Эпифизы: округлые суставные головы на концах кости
                local epi = boneDiameter * 1.3
                bioNode("BoneEpi_Top", Vector3.new(epi, epi, epi), BONE_COLOR, Enum.Material.Slate, BONE_FADE, bone, 0.5, 0, true, "X", limbName)
                bioNode("BoneEpi_Bot", Vector3.new(epi, epi, epi), BONE_COLOR, Enum.Material.Slate, BONE_FADE, bone, -0.5, 0, true, "X", limbName)
                -- ВТОРАЯ КОСТЬ (лучевая/локтевая): параллельно, тоньше и короче
                local bone2D = boneDiameter * 0.55
                bioPart(
                    "Bone2",
                    Vector3.new(boneLen * 0.92, bone2D, bone2D),
                    BONE_COLOR,
                    Enum.Material.Slate,
                    BONE_FADE,
                    anchorPart,
                    topOffset * CFrame.new(0, 0, boneDiameter / 2 + bone2D / 2 + 0.02),
                    0,
                    true,
                    limbName
                )
                -- Межкостные гребни: продольные кили вдоль диафиза
                local ridgeLen = boneLen * 0.72
                bioNode("BoneRidge", Vector3.new(ridgeLen, 0.05, 0.05), BONE_COLOR, Enum.Material.Slate, BONE_FADE, bone, 0.06, 0, false, "X", limbName, CFrame.new(0, boneDiameter / 2 + 0.02, 0))
                bioNode("BoneRidge", Vector3.new(ridgeLen, 0.05, 0.05), BONE_COLOR, Enum.Material.Slate, BONE_FADE, bone, -0.06, 0, false, "X", limbName, CFrame.new(0, -boneDiameter / 2 - 0.02, 0))
            end
        end
        setPrinterStatus("ПЕЧАТЬ: " .. limbName .. " // КОСТЬ")
        task.wait(BONE_FADE * speed)

        -- ФАЗА 2: НЕРВЫ — чистая сеть: стволы + ганглии, артерии, вены,
        -- капилляры, перемычки (без ветвлений и неона, v65.3)
        buildNerveSystem(anchorPart, boneLen, boneDiameter, bone, topOffset, limbName)
        setPrinterStatus("ПЕЧАТЬ: " .. limbName .. " // НЕРВЫ")
        task.wait(NERVE_FADE * speed)

        -- ФАЗА 3: МЫШЦЫ — НЕПРОЗРАЧНАЯ красная плоть + яркие волокна
        local fleshSize = originalSize * 0.96
        bioPart("Flesh", fleshSize, FLESH_COLOR, Enum.Material.SmoothPlastic, FLESH_FADE, anchorPart, topOffset, 0, false, limbName)
        local fiberR = fleshSize.X / 2 - 0.02
        for i = 1, 4 do
            local angle = (i - 1) * math.pi / 2 + math.pi / 4
            bioPart(
                "MuscleFiber_" .. i,
                Vector3.new(0.07, fleshSize.Y * 0.97, 0.07),
                FIBER_COLOR,
                Enum.Material.SmoothPlastic,
                FLESH_FADE,
                anchorPart,
                topOffset * CFrame.new(math.cos(angle) * fiberR, 0, math.sin(angle) * fiberR),
                0,
                false,
                limbName
            )
        end
        setPrinterStatus("ПЕЧАТЬ: " .. limbName .. " // МЫШЦЫ")
        task.wait(FLESH_FADE * speed)

        -- ФАЗА 4: КОЖА — цвет и МАТЕРИАЛ оригинальной конечности, часть за частью
        for _, p in ipairs(parts) do
            local orig = getgenv().originalDataRef[p]
            if orig then
                bioPart(
                    "Skin",
                    p.Size * 1.01,
                    orig.Color,
                    orig.Material or Enum.Material.SmoothPlastic,
                    SKIN_FADE,
                    p,
                    CFrame.new(0, p.Size.Y / 2, 0),
                    0,
                    false,
                    limbName
                )
            end
        end
        setPrinterStatus("ПЕЧАТЬ: " .. limbName .. " // КОЖА")
        task.wait((SKIN_FADE + 0.1) * speed)

        -- ФИНАЛ: сносим ТОЛЬКО СВОИ части принта (параллельные регенерации не трогаем)
        local list = getgenv().activePrinterParts
        for i = #list, 1, -1 do
            if list[i].Limb == limbName then
                if list[i].Instance then list[i].Instance:Destroy() end
                table.remove(list, i)
            end
        end

        -- звук генерации: снимаем нашего "слушателя" — глохнет, когда закончили ВСЕ
        endPrintSound()

        for _, p in ipairs(parts) do
            p.Transparency = 0
            spawnPortalFlash(p, COLOR_FLASH_OUT)
        end

        getgenv().busyLimbsRef[limbName] = false
        setPrinterStatus("ГОТОВО // " .. limbName)
        task.delay(1.5, function()
            if #getgenv().activePrinterParts == 0 and not getgenv().ShatterActive then
                setPrinterStatus("ОЖИДАНИЕ")
            end
        end)
    end)
end

-- Конечность: регенерируется при уроне (и после распада)
getgenv().regenerateLimb = function(limbName)
    if getgenv().busyLimbsRef[limbName] then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local limbTable = (hum.RigType == Enum.HumanoidRigType.R6) and R6_LIMBS or R15_LIMBS
    local partsInOrder = limbTable[limbName]
    if not partsInOrder then return end
    local parts = {}
    for _, name in ipairs(partsInOrder) do
        local p = char:FindFirstChild(name)
        if p then table.insert(parts, p) end
    end
    if #parts == 0 then return end
    getgenv().busyLimbsRef[limbName] = true
    runPrintSequence(limbName, parts)
end

-- Торс: регенерируется ТОЛЬКО после распада на части (при уроне НЕ вызывается)
getgenv().regenerateTorso = function()
    if getgenv().busyLimbsRef["Torso"] then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local partsInOrder = (hum.RigType == Enum.HumanoidRigType.R6) and TORSO_PARTS.R6 or TORSO_PARTS.R15
    local parts = {}
    for _, name in ipairs(partsInOrder) do
        local p = char:FindFirstChild(name)
        if p then table.insert(parts, p) end
    end
    if #parts == 0 then return end
    getgenv().busyLimbsRef["Torso"] = true
    runPrintSequence("Torso", parts)
end

-- =====================================================================
-- РАСПАД НА ЧАСТИ: тело разлетается с кровью (настоящая физика — куски
-- ПАДАЮТ на землю), происходит РЕСЕТ (смерть+респавн), персонаж
-- ВОЗРОЖДАЕТСЯ НА ТОМ ЖЕ МЕСТЕ, где распался, и полностью регенерирует.
-- ЗВУК РАСПАДА: играет ТОЛЬКО после телепорта на место распада.
-- =====================================================================
getgenv().shatterBody = function()
    if getgenv().ShatterActive then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not root or hum.Health <= 0 then return end

    getgenv().ShatterActive = true
    setPrinterStatus("💥 РАСПАД НА ЧАСТИ...")

    task.spawn(function()
        local deathCF = root.CFrame -- запоминаем ГДЕ распались
        local rootPos = root.Position

        -- 1) ФИЗИЧЕСКИЕ копии всех видимых частей: разлетаются с брызгами крови
        local clones = {}
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" and obj.Transparency < 1 then
                local clone = obj:Clone()
                for _, c in ipairs(clone:GetChildren()) do
                    if c:IsA("Motor6D") or c:IsA("JointInstance") then c:Destroy() end
                end
                clone.Anchored = false
                clone.CanCollide, clone.CanTouch, clone.CanQuery, clone.Massless = true, false, false, true
                clone.Parent = workspace
                local dir = obj.Position - rootPos
                if dir.Magnitude < 0.05 then
                    dir = Vector3.new(math.random() - 0.5, 0.5, math.random() - 0.5)
                end
                dir = dir.Unit
                clone.AssemblyLinearVelocity = dir * (15 + math.random() * 15) + Vector3.new(0, 10 + math.random() * 12, 0)
                clone.AssemblyAngularVelocity = Vector3.new(math.random() * 24 - 12, math.random() * 24 - 12, math.random() * 24 - 12)
                table.insert(clones, clone)
                spawnBloodBurst(obj.CFrame, 6)
            end
        end

        -- 2) прячем настоящее тело и снимаем коллизии
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Transparency = 1
                obj.CanCollide = false
            elseif obj:IsA("Decal") then
                obj.Transparency = 1
            end
        end

        -- 3) РЕСЕТ: убиваем персонажа — игра делает респавн сама (БЕЗ звука)
        setPrinterStatus("ОЖИДАНИЕ РЕСПАВНА...")
        hum.Health = 0
        hum:ChangeState(Enum.HumanoidStateType.Dead)

        -- 4) ждём новое тело и ПЕРЕНОСИМ ЕГО НА МЕСТО РАСПАДА
        local newChar = nil
        local gotRespawn = false
        local respawnConn = LocalPlayer.CharacterAdded:Connect(function(c)
            newChar = c
            gotRespawn = true
        end)
        local t0 = os.clock()
        while not gotRespawn and os.clock() - t0 < 15 do
            task.wait(0.1)
        end
        respawnConn:Disconnect()

        if newChar then
            local newRoot = newChar:WaitForChild("HumanoidRootPart", 10)
            if newRoot then
                task.wait(0.2)
                newRoot.CFrame = deathCF -- возвращаемся ГДЕ РАСПАЛИСЬ
                task.wait(0.25)
                newRoot.CFrame = deathCF -- повторно: если игра телепортнула на спавн
                spawnPortalFlash(newRoot, COLOR_FLASH_OUT)
                -- ЗВУК РАСПАДА: играет ТОЛЬКО сейчас — мы тепнулись на место распада
                playSoundAt(newRoot, SHATTER_SOUND_ID, 2, 1, false)
            end
        end

        -- 5) убираем разлетевшиеся куски
        for _, clone in ipairs(clones) do
            if clone and clone.Parent then clone:Destroy() end
        end

        if not newChar then
            setPrinterStatus("РЕСПАВН НЕ ПРИШЁЛ (АВТО-РЕСПАВН ВЫКЛЮЧЕН?)")
            getgenv().ShatterActive = false
            return
        end
        setPrinterStatus("ТЕЛО ВОССТАНОВЛЕНО // ПОЛНАЯ РЕГЕНЕРАЦИЯ")

        -- 6) полная регенерация: ТОРС + 4 конечности (параллельно, со сдвигом старта)
        for i, limbName in ipairs({"Torso", "RightArm", "LeftArm", "RightLeg", "LeftLeg"}) do
            task.delay(0.25 * (i - 1), function()
                getgenv().busyLimbsRef[limbName] = false
                if limbName == "Torso" then
                    if getgenv().regenerateTorso then getgenv().regenerateTorso() end
                else
                    if getgenv().regenerateLimb then getgenv().regenerateLimb(limbName) end
                end
            end)
        end

        getgenv().ShatterActive = false
    end)
end

local function pickRandomFreeLimb()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local limbTable = (hum.RigType == Enum.HumanoidRigType.R6) and R6_LIMBS or R15_LIMBS
    local free = {}
    for name in pairs(limbTable) do
        if not getgenv().busyLimbsRef[name] then table.insert(free, name) end
    end
    if #free == 0 then return nil end
    return free[math.random(1, #free)]
end

local function setupCharacter(character)
    local hum = character:WaitForChild("Humanoid", 10)
    if not hum then return end
    local limbTable = (hum.RigType == Enum.HumanoidRigType.R6) and R6_LIMBS or R15_LIMBS
    for _, parts in pairs(limbTable) do
        for _, partName in ipairs(parts) do
            local p = character:WaitForChild(partName, 5)
            if p then
                getgenv().originalDataRef[p] = {Color = p.Color, Material = p.Material, Transparency = p.Transparency}
            end
        end
    end

    -- v65.2+: WalkSpeed НЕ трогаем ВООБЩЕ — скорость и спринт игры как есть

    local previousHealth = hum.Health
    track(hum.HealthChanged:Connect(function(newHealth)
        local tookDamage = newHealth < previousHealth

        -- РЕЗЕРВНЫЙ ПРОТОКОЛ (v65.3): спасение при критическом ХП.
        -- Преимущество честное: раз в кулдаун, по порогу, без бессмертия.
        -- Канон Прайма — у оригинала всегда есть запасной план.
        if tookDamage and newHealth > 0 and config.SecondWind
            and not getgenv().ShatterActive
            and newHealth <= config.SecondWindHP then
            if os.clock() >= (getgenv().SecondWindReadyAt or 0) then
                getgenv().SecondWindReadyAt = os.clock() + (config.SecondWindCD or 90)
                local heal = (hum.MaxHealth or 100) * (config.SecondWindHeal or 0.4)
                hum.Health = math.min(hum.MaxHealth or 100, newHealth + heal)
                local rootSW = character:FindFirstChild("HumanoidRootPart")
                if rootSW then
                    playSoundAt(rootSW, PRINT_SOUND_ID, 1, 1.5, false) -- быстрый «перезапуск»
                end
                setPrinterStatus("🧬 РЕЗЕРВНЫЙ ПРОТОКОЛ: +" .. math.floor(heal) .. " HP")
            else
                local left = math.ceil((getgenv().SecondWindReadyAt or 0) - os.clock())
                setPrinterStatus("РЕЗЕРВНЫЙ ПРОТОКОЛ: ПЕРЕЗАРЯДКА " .. left .. "с")
            end
        end

        -- АВТО-РАСПАД при низком ХП
        if config.AutoShatter and getgenv().shatterBody
            and newHealth > 0 and newHealth <= config.ShatterHP
            and not getgenv().ShatterActive then
            getgenv().shatterBody()
        end

        -- АВТО-РЕГЕН при уроне: лимита нет — каждая пуля может запустить свою конечность
        if tookDamage and newHealth > 0 and config.AutoRegen then
            local limb = pickRandomFreeLimb()
            if limb and getgenv().regenerateLimb then
                getgenv().regenerateLimb(limb)
            end
        end
        previousHealth = hum.Health
    end))
end

if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
track(LocalPlayer.CharacterAdded:Connect(setupCharacter))

-- Heartbeat: ТОЛЬКО доводка Weld'ов (верх принта прижат к конечности,
-- часть растёт вниз; узлы скользят по растущим частям).
track(RunService.Heartbeat:Connect(function()
    local list = getgenv().activePrinterParts
    if #list > 0 then
        for _, data in ipairs(list) do
            local inst = data.Instance
            if inst and inst.Parent and data.Weld then
                if data.Mode == "Grow" then
                    data.Weld.C0 = data.BaseOffset * CFrame.new(0, -inst.Size.Y / 2, 0)
                elseif data.Mode == "GrowCyl" then
                    data.Weld.C0 = data.BaseOffset * CYL_ROT * CFrame.new(-inst.Size.X / 2, 0, 0)
                elseif data.Mode == "Node" and data.Host and data.Host.Parent then
                    local rot = data.Rot or CFrame.new()
                    if data.Axis == "X" then
                        data.Weld.C0 = CFrame.new(data.Host.Size.X * data.Frac, 0, 0) * rot
                    else
                        data.Weld.C0 = CFrame.new(0, data.Host.Size.Y * data.Frac, 0) * rot
                    end
                end
            end
        end
    end
end))

