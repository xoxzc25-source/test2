-- Слайдеры
local activeSliders = {}

local function createSlider(text, y, min, max, default, isInt, cb)
    local titleS = Instance.new("TextLabel", content)
    titleS.Size, titleS.Position, titleS.BackgroundTransparency, titleS.ZIndex =
        UDim2.new(1, 0, 0, 14), UDim2.new(0, 4, 0, y), 1, 3
    titleS.TextColor3, titleS.Font, titleS.TextSize, titleS.TextXAlignment = COLOR_NEON, Enum.Font.Code, 9, Enum.TextXAlignment.Left
    titleS.Text = text .. " -> " .. (isInt and string.format("%d", default) or string.format("%.1f", default)) .. (isInt and "" or "x")

    local line = Instance.new("Frame", content)
    line.Size, line.Position, line.BackgroundColor3, line.BorderSizePixel, line.ZIndex =
        UDim2.new(1, -8, 0, 3), UDim2.new(0, 4, 0, y + 19), Color3.fromRGB(40, 12, 12), 0, 4
    mkCorner(line, 3)

    local fill = Instance.new("Frame", line)
    fill.Size, fill.BackgroundColor3, fill.BorderSizePixel, fill.ZIndex =
        UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0), COLOR_NEON, 0, 5
    mkCorner(fill, 3)

    local dot = Instance.new("TextButton", content)
    dot.Size = UDim2.fromOffset(10, 10)
    dot.BackgroundColor3, dot.BorderSizePixel, dot.Text, dot.ZIndex = COLOR_NEON, 0, "", 6
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    local initPct = math.clamp((default - min) / (max - min), 0, 1)
    dot.Position = UDim2.new(0, 4 + (initPct * 258), 0, y + 15)

    local sliderData = {
        Dragging = false, Button = dot, Bar = fill, BG = line,
        Min = min, Max = max, Title = titleS, Text = text,
        IsInt = isInt, Callback = cb, YCoord = y + 15
    }
    table.insert(activeSliders, sliderData)

    dot.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderData.Dragging = true
        end
    end)
end

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        for _, slider in ipairs(activeSliders) do slider.Dragging = false end
    end
end))

track(UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        for _, slider in ipairs(activeSliders) do
            if slider.Dragging then
                local pct = math.clamp((input.Position.X - slider.BG.AbsolutePosition.X) / slider.BG.AbsoluteSize.X, 0, 1)
                slider.Button.Position = UDim2.new(0, 4 + (pct * (slider.BG.AbsoluteSize.X - 10)), 0, slider.YCoord)
                slider.Bar.Size = UDim2.new(pct, 0, 1, 0)
                local value = slider.Min + (pct * (slider.Max - slider.Min))
                if slider.IsInt then
                    value = math.floor(value)
                    slider.Title.Text = slider.Text .. " -> " .. string.format("%d", value)
                else
                    slider.Title.Text = slider.Text .. " -> " .. string.format("%.1f", value) .. "x"
                end
                slider.Callback(value)
            end
        end
    end
end))

