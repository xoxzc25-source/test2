-- Проигрывает звук, привязанный к части. speed замедляет трек
-- (длительность = 1/speed), looped — для цикла во время печати.
local function playSoundAt(parent, id, volume, speed, looped)
    if not parent then return nil end
    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume or 1
    sound.PlaybackSpeed = speed or 1
    sound.Looped = looped or false
    sound.Parent = parent
    sound:Play()
    if not looped then
        sound.Ended:Connect(function() sound:Destroy() end)
        task.delay(10, function()
            if sound and sound.Parent then sound:Destroy() end
        end)
    end
    return sound
end

-- ОБЩИЙ звук генерации: ОДИН на все активные печати.
-- 5 конечностей не орут в 5 слоёв — трек просто продолжается,
-- пока печатается хоть что-то, и глохнет, когда закончили ВСЕ.
local function startPrintSound(parentPart, totalTime)
    getgenv().PrintSoundUsers = (getgenv().PrintSoundUsers or 0) + 1
    local s = getgenv().ActivePrintSound
    if s and s.Parent then
        return -- уже играет, второй слой не нужен
    end
    getgenv().ActivePrintSound = playSoundAt(parentPart, PRINT_SOUND_ID, 1, math.clamp(1 / totalTime, 0.3, 1.25), true)
end

local function endPrintSound()
    local n = (getgenv().PrintSoundUsers or 1) - 1
    if n <= 0 then
        getgenv().PrintSoundUsers = 0
        local s = getgenv().ActivePrintSound
        if s then
            pcall(function() s:Stop() end)
            pcall(function() s:Destroy() end)
        end
        getgenv().ActivePrintSound = nil
    else
        getgenv().PrintSoundUsers = n
    end
end

-- =====================================================================
-- ЯДРО ПЕЧАТИ: всё приваривается Weld'ами к реальной (невидимой)
-- конечности, поэтому двигается вместе с анимациями персонажа.
-- Каждая часть помечена тегом Limb — регенерации работают ПАРАЛЛЕЛЬНО.
-- =====================================================================

-- Общая часть-принт: растёт ВНИЗ от точки baseOffset (верх конечности),
-- верх прижат к конечности, сама часть приварена к attachTo.
-- isCylinder = true -> цилиндр (трубчатая кость): ось X разворачивается вдоль конечности.
local function bioPart(name, finalSize, color, material, duration, attachTo, baseOffset, transparency, isCylinder, limbTag)
    local char = LocalPlayer.Character
    if not char or not attachTo then return nil end

    local part = Instance.new("Part")
    part.Name = "QuantumBio_" .. name
    part.Color = color
    part.Material = material
    part.Transparency = transparency or 0
    part.CanCollide, part.CanTouch, part.CanQuery, part.Massless, part.Anchored = false, false, false, true, false

    if isCylinder then
        part.Shape = Enum.PartType.Cylinder
        -- цилиндр растёт вдоль своей оси X: стартуем короткой "шайбой"
        part.Size = Vector3.new(0.05, finalSize.Y, finalSize.Z)
    else
        -- старт: тонкая пластина у верхней точки, растёт вниз до finalSize
        part.Size = Vector3.new(finalSize.X, 0.05, finalSize.Z)
    end
    part.Parent = char

    local weld = Instance.new("Weld")
    weld.Part0 = attachTo
    weld.Part1 = part
    if isCylinder then
        -- верх цилиндра прижат к точке роста (baseOffset), рост идёт вниз
        weld.C0 = baseOffset * CYL_ROT * CFrame.new(-part.Size.X / 2, 0, 0)
    else
        -- верх части прижат к точке роста (baseOffset), рост идёт вниз
        weld.C0 = baseOffset * CFrame.new(0, -part.Size.Y / 2, 0)
    end
    weld.Parent = part

    table.insert(getgenv().activePrinterParts, {
        Instance = part,
        Weld = weld,
        BaseOffset = baseOffset,
        Mode = isCylinder and "GrowCyl" or "Grow",
        Limb = limbTag
    })

    TweenService:Create(
        part,
        TweenInfo.new(duration * config.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {Size = finalSize}
    ):Play()
    return part
end

-- Деталь на растущей части: сидит на высоте frac по оси роста host-части
-- (0.5 = верх, 0 = центр, -0.5 = низ). Появляется плавным проявлением.
-- axis = "Y" (обычная часть) или "X" (кость-цилиндр).
-- rot — поворот/смещение детали (рёбра, гребни).
local function bioNode(name, size, color, material, duration, host, frac, finalTransparency, isBall, axis, limbTag, rot)
    local char = LocalPlayer.Character
    if not char or not host then return nil end

    local part = Instance.new("Part")
    part.Name = "QuantumBio_" .. name
    part.Color = color
    part.Material = material
    part.Transparency = 1
    part.CanCollide, part.CanTouch, part.CanQuery, part.Massless, part.Anchored = false, false, false, true, false
    if isBall then part.Shape = Enum.PartType.Ball end
    part.Size = size
    part.Parent = char

    local weld = Instance.new("Weld")
    weld.Part0 = host
    weld.Part1 = part
    rot = rot or CFrame.new()
    if (axis or "Y") == "X" then
        -- кость-цилиндр: ось роста = локальная X, верх = +X
        weld.C0 = CFrame.new(host.Size.X * frac, 0, 0) * rot
    else
        weld.C0 = CFrame.new(0, host.Size.Y * frac, 0) * rot
    end
    weld.Parent = part

    table.insert(getgenv().activePrinterParts, {
        Instance = part,
        Weld = weld,
        Mode = "Node",
        Host = host,
        Frac = frac,
        Axis = axis or "Y",
        Rot = rot,
        Limb = limbTag
    })

    TweenService:Create(
        part,
        TweenInfo.new(duration * config.RegenSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {Transparency = finalTransparency or 0.15}
    ):Play()
    return part
end

-- =====================================================================
-- НЕРВНО-СОСУДИСТАЯ СЕТЬ — ЧИСТАЯ версия (v65.1): 4 нервных ствола
-- с ганглиями, красные артерии, синие вены, 6 капилляров и перемычки
-- на кости. Без ветвлений и неона.
-- =====================================================================
local function buildNerveSystem(anchorPart, boneLen, boneDiameter, bone, topOffset, limbTag)
    local rNerve = boneDiameter / 2 + 0.05
    local rBlood = boneDiameter / 2 + 0.03
    local rCap   = boneDiameter / 2 + 0.06

    -- 1) нервные стволы (бледные, тёплый оттенок) + утолщения-ганглии
    local dirs = { {rNerve, rNerve}, {-rNerve, rNerve}, {rNerve, -rNerve}, {-rNerve, -rNerve} }
    for i, d in ipairs(dirs) do
        local s = bioPart(
            "Nerve_" .. i,
            Vector3.new(0.04, boneLen * 1.06, 0.04),
            NERVE_COLOR,
            Enum.Material.SmoothPlastic,
            NERVE_FADE,
            anchorPart,
            topOffset * CFrame.new(d[1], 0, d[2]),
            0,
            false,
            limbTag
        )
        if s then
            bioNode("NerveNode", Vector3.new(0.085, 0.085, 0.085), NERVE_NODE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, s, 0.25, 0, true, "Y", limbTag)
            bioNode("NerveNode", Vector3.new(0.085, 0.085, 0.085), NERVE_NODE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, s, -0.15, 0, true, "Y", limbTag)
        end
    end

    -- 2) артерии: красные, ближе к кости
    local arteryDirs = { {-rBlood, 0}, {rBlood * 0.7, rBlood * 0.7} }
    for i, d in ipairs(arteryDirs) do
        bioPart(
            "Artery_" .. i,
            Vector3.new(0.05, boneLen * 1.0, 0.05),
            ARTERY_COLOR,
            Enum.Material.SmoothPlastic,
            NERVE_FADE,
            anchorPart,
            topOffset * CFrame.new(d[1], 0, d[2]),
            0,
            false,
            limbTag
        )
    end

    -- 3) вены: синие, тоже у кости
    local veinDirs = { {0, -rBlood}, {-rBlood * 0.7, rBlood * 0.7} }
    for i, d in ipairs(veinDirs) do
        bioPart(
            "Vein_" .. i,
            Vector3.new(0.05, boneLen * 1.02, 0.05),
            VEIN_COLOR,
            Enum.Material.SmoothPlastic,
            NERVE_FADE,
            anchorPart,
            topOffset * CFrame.new(d[1], 0, d[2]),
            0,
            false,
            limbTag
        )
    end

    -- 4) капилляры: тонкие струны по кругу, красные и синие вперемешку
    for i = 1, 6 do
        local angle = (i - 1) * math.pi / 3 + math.pi / 12
        local capColor = (i % 2 == 0) and ARTERY_COLOR or VEIN_COLOR
        bioPart(
            "Capillary_" .. i,
            Vector3.new(0.025, boneLen * (0.82 + (i % 3) * 0.09), 0.025),
            capColor,
            Enum.Material.SmoothPlastic,
            NERVE_FADE,
            anchorPart,
            topOffset * CFrame.new(math.cos(angle) * rCap, 0, math.sin(angle) * rCap),
            0,
            false,
            limbTag
        )
    end

    -- 5) поперечные перемычки на кости (кость-цилиндр: ось X)
    local barLen = rNerve * 2 + 0.1
    bioNode("NerveBarX", Vector3.new(barLen, 0.03, 0.03), NERVE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, bone, 0.2, 0, false, "X", limbTag)
    bioNode("NerveBarX", Vector3.new(barLen, 0.03, 0.03), NERVE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, bone, -0.1, 0, false, "X", limbTag)
    bioNode("NerveBarZ", Vector3.new(0.03, 0.03, barLen), NERVE_COLOR, Enum.Material.SmoothPlastic, NERVE_FADE, bone, 0.05, 0, false, "X", limbTag)
end

